CREATE DATABASE IF NOT EXISTS `Laptop_Inventory`;
USE `Laptop_Inventory`; 

SELECT * FROM laptop_inventory.laptop_data ;

-- Step1. Check The Table Column Type
DESCRIBE laptop_data;

-- Step2. Drop Column That We Don't Want it
ALTER TABLE laptop_data
DROP COLUMN `Unnamed: 0`; 
  
ALTER TABLE laptop_data
DROP COLUMN MyUnknownColumn;

SELECT * FROM laptop_data;

-- Step3 . Standardize Column
-- A. (brand)
SELECT brand, COUNT(*) as Count
FROM laptop_data
GROUP BY brand 
ORDER BY count DESC;

-- B.(name)
SELECT name, COUNT(*) AS COUNT 
FROM laptop_data
GROUP BY name
HAVING count > 1 
ORDER BY Count DESC; 

-- Remove corrupted character â€Ž 

UPDATE laptop_data
SET name = TRIM(REGEXP_REPLACE(name, 'â€Ž', ''))
WHERE name LIKE '%â€Ž%';

SELECT name FROM laptop_data ;

-- Trim extra spaces inside name
UPDATE laptop_data
SET name = TRIM(REGEXP_REPLACE(name, ' +', ' '))
WHERE name LIKE '%  %';

SELECT name FROM laptop_data ;

-- Confirm both fixes
SELECT name FROM laptop_data 
WHERE name LIKE '%â€Ž%' 
   OR name LIKE '%  %';


-- C. (Price) 
SELECT price FROM laptop_data;
-- Check MAX, MIN , AVG price
SELECT 
	MAX(price) as Max_Price,
    MIN(price) as MIN_Price,
    AVG(price) as Average_Price
FROM laptop_data ;

-- Check for any suspicious outliers (too cheap or too expensive)
SELECT name, brand, price 
FROM laptop_data
WHERE price < 10000 OR price > 500000
ORDER BY price;

-- D. (spec_rating) 
SELECT `spec_rating` FROM laptop_data;

-- Check current spec_rating values
SELECT 
	MIN(`spec_rating`) as Min_rating,
    MAX(`spec_rating`) as Max_rating,
    AVG(`spec_rating`) as Average_rating
FROM laptop_data;

-- Round all spec_rating values to 2 decimal places
UPDATE laptop_data
SET spec_rating = ROUND(spec_rating, 2);



-- Change column type to DECIMAL to enforce 2 decimal places
ALTER TABLE laptop_data
MODIFY COLUMN spec_rating DECIMAL(5,2);

-- Verify rounding worked
SELECT spec_rating, COUNT(*) as count
FROM laptop_data
GROUP BY spec_rating
ORDER BY count DESC
LIMIT 10;-- Verify rounding worked
SELECT spec_rating, COUNT(*) as count
FROM laptop_data
GROUP BY spec_rating
ORDER BY count DESC
LIMIT 10;

-- E. (processor)
SELECT processor FROM laptop_data; 

-- Check distinct processor values
SELECT processor, COUNT(*) AS Count 
FROM laptop_data
GROUP BY processor 
ORDER BY Count DESC
LIMIT 10; 

-- Check all inconsistent AMD casing
SELECT processor, COUNT(*) as count
FROM laptop_data
WHERE processor LIKE '%Amd%'
GROUP BY processor
ORDER BY count DESC;

-- Fix: Replace 'Amd' with 'AMD' everywhere
UPDATE laptop_data
SET processor = REPLACE(processor, 'Amd', 'AMD')
WHERE processor LIKE '%Amd%';

-- Should return 0 rows if fully clean
SELECT processor FROM laptop_data
WHERE processor LIKE '%Amd%';

-- F. (Ram)
SELECT Ram FROM
laptop_data ; 

-- Check Distinct Values
SELECT Ram, COUNT(*) AS Count
FROM Laptop_data
GROUP BY Ram 
ORDER BY Count DESC;

--  Extract numeric value from
SELECT Ram, CAST(REPLACE(Ram, 'GB', '') AS UNSIGNED) as Ram_numeric
FROM laptop_data
GROUP BY Ram;

-- Add a new column for numeric Ram value
ALTER TABLE laptop_data
ADD COLUMN Ram_GB INT AFTER Ram;

SELECT * FROM Laptop_data;

-- Fill the new column with numeric values
UPDATE laptop_data
SET Ram_GB = CAST(REPLACE(Ram, 'GB', '') AS UNSIGNED);

-- Drop the old string column
ALTER TABLE laptop_data
DROP COLUMN Ram;

-- Rename new column to Ram
ALTER TABLE laptop_data
RENAME COLUMN Ram_GB TO Ram;


-- G. (Ram_type) 
SELECT Ram_type FROM Laptop_data; 

-- Check distinct Ram_type values
SELECT Ram_type, COUNT(*) as count
FROM laptop_data
GROUP BY Ram_type
ORDER BY count DESC;

-- Fix DDR4- trailing dash
UPDATE laptop_data
SET Ram_type = 'DDR4'
WHERE Ram_type = 'DDR4-';

-- Check the DDR1 row to decide what to do
SELECT name, brand, Ram, Ram_type, price
