-- J(resolution_Width)
SELECT OS FROM Laptop_data;

-- Check distinct resolution_width values
SELECT OS, COUNT(*) as count
FROM laptop_data
GROUP BY OS
ORDER BY count DESC;

-- Double spaces in Windows 11 OS
UPDATE laptop_data
SET OS = 'Windows 11 OS'
WHERE OS = 'Windows 11  OS';

-- Double spaces in Windows 10 OS
UPDATE laptop_data
SET OS = 'Windows 10 OS'
WHERE OS = 'Windows 10  OS';

--  Standardize 'Windows OS' to 'Windows 11 OS'
UPDATE laptop_data
SET OS = 'Windows 11 OS'
WHERE OS = 'Windows OS';

--  Standardize 'DOS 3.0 OS' to 'DOS OS'
UPDATE laptop_data
SET OS = 'DOS OS'
WHERE OS = 'DOS 3.0 OS';

-- Standardize all Mac versions to 'Mac OS'
UPDATE laptop_data
SET OS = 'Mac OS'
WHERE OS IN ('Mac 10.15.3 OS', 'Mac Catalina OS', 'Mac High Sierra OS');

-- Force fix using LENGTH to target exact 15 character values
UPDATE laptop_data
SET OS = 'Mac OS'
WHERE LENGTH(OS) = 15 AND OS LIKE '%Mac%';

-- Check The Final Resulte 
SELECT OS, COUNT(*) as count
FROM laptop_data
GROUP BY OS
ORDER BY count DESC;

